

<div class="container">
  <div class="card p-4 shadow-sm">
    <h1>Login</h1>
<div class="login">
  <%= form_with model: @user, url: session_path, local: true do |f| %>
    <div class="form-group mb-3">
      <%= f.label :email, class: 'form-label' %>
      <%= f.text_field :email, class: 'form-control', placeholder: 'Enter your email' %>
    </div>

    <div class="form-group mb-3">
      <%= f.label :password, class: 'form-label' %>
      <%= f.password_field :password, class: 'form-control', placeholder: 'Enter your password' %>
    </div>

    <div class="form-group mb-3">
      <%= f.submit "Login", class: 'btn btn-primary' %>
    </div>
  <% end %>

  <%= link_to "Forgot Password?", new_password_reset_path, class: 'btn btn-link' %>
</div>
</div>
</div>
