<%= link_to("Go Back", classrooms_path, class: "btn btn-secondary mb-3") %>

<div class="delete-self-user">
  <h1 class="mb-4">Delete User</h1>

  <%= form_for @user, method: :delete do |f| %>
    <p>Are you sure you want to delete this account?</p>
    
    <table class="table table-bordered mb-4">
      <tr>
        <th>Name</th>
        <td><%= f.object.name %></td>
      </tr>
      <tr>
        <th>Email</th>
        <td><%= f.object.email %></td>
      </tr>
      <tr>
        <th>Role</th>
        <td><%= f.object.role %></td>
      </tr>
    </table>

    <div class="form-group">
      <%= f.submit("Delete Account", class: "btn btn-danger btn-lg") %>
    </div>
  <% end %>
</div>
