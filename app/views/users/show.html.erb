<div class="show-user">
    <h1><%= "#{@user.name}'s Profile" %></h1>
    <p><strong>Email:</strong> <%= @user.email %></p>
    <p><strong>Role:</strong> <%= @user.role %></p>
    <%= link_to 'Back to Classrooms', classrooms_path, class: 'btn btn-secondary' %>
    <%if can? :edit, @user%>
        <%= link_to 'Edit Your Information', edit_user_path(@user), class: 'btn btn-primary' %>
    <%end%>
    <%if can? :delete, @user%>
    <%= link_to 'Delete this account', delete_user_path(@user), class: 'btn btn-secondary' %>
    <%end%>
</div>

 
