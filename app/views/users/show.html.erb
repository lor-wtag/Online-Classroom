<div class="container mt-5">
  <div class="card p-4 shadow-sm">
    <h1 class="text-center mb-4"><%= "#{@user.name}'s Profile" %></h1>
    
    <p><strong>Email:</strong> <%= @user.email %></p>
    <p><strong>Role:</strong> <%= @user.role %></p>

    <div class="d-flex justify-content-between mt-4">
      <%= link_to 'Back to Classrooms', classrooms_path, class: 'btn btn-secondary' %>
      
      <% if can? :edit, @user %>
        <%= link_to 'Edit Your Information', edit_user_path(@user), class: 'btn btn-primary' %>
      <% end %>

      <% if can? :delete, @user %>
        <%= link_to 'Delete this account', delete_user_path(@user), class: 'btn btn-danger' %>
      <% end %>
    </div>
  </div>
</div>
