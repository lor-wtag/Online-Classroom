<div class="user index">
    <h2>All Registered Users</h2>
    <%if @users.empty?%>
        <h3>No users found<h3>
    <%else%>
        <table class="listing" summary="User List">
            <tr class="header">
                <th><%= t('table_headers.number') %></th>
                <th><%= t('table_headers.name') %></th>
                <th><%= t('table_headers.email') %></th>
                <th><%= t('table_headers.role') %></th>
                <th><%= t('table_headers.actions') %></th>
            </tr>
            <%@users.each do |user| %>
            <tr>
                <td><%= user.id%></td>
                <td><%= user.name%></td>
                <td><%= user.email%></td>
                <td><%= user.role%></td>
                <td class="actions">
                    <%=link_to("Show", user_path(user),:class => "action edit")%>
                    <%=link_to("Edit", edit_user_path(user),:class => "action edit")%>
                    <%=link_to("Delete", delete_user_path(user),:class => "action edit")%>
                </td>
            </tr>
            <%end%>
        </table>
    <%end%>
</div>
