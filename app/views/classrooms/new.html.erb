<h1>Create A New Classroom</h1>
<div class="classroom-new">
  <%= form_with(model: @classroom, local: true) do |f| %>
    <% if @classroom.errors.any? %>
      <div class="error-messages">
        <h2>There are errors:</h2>
        <ul>
          <% @classroom.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <table summary="New Classroom form field">
      <tr>
        <th>Classroom Name</th>
        <td><%= f.text_field(:name) %></td>
      </tr>
      <tr>
        <th>Course Code</th>
        <td><%= f.text_field(:course_code) %></td>
      </tr>
    </table>

    <div class="form buttons">
      <%= f.submit("Create new classroom") %>
    </div>
  <% end %>
</div>

