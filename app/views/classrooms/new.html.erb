<h1 class="mb-4">Create A New Classroom</h1>

<div class="classroom-new">
  <%= form_with(model: @classroom, local: true) do |f| %>
    <% if @classroom.errors.any? %>
      <div class="alert alert-danger">
        <h4><%= pluralize(@classroom.errors.count, "error") %> prohibited this classroom from being saved:</h4>
        <ul>
          <% @classroom.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-group">
      <%= f.label :name, class: "form-label" %>
      <%= f.text_field :name, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= f.label :course_code, class: "form-label" %>
      <%= f.text_field :course_code, class: "form-control" %>
    </div>

    <div class="form-group mt-3">
      <%= f.submit "Create New Classroom", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
