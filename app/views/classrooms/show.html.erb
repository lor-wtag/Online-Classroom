<div class="show-classroom">
  <h1><%= @classroom.name %></h1>
  <p><strong>Course Code:</strong> <%= @classroom.course_code %></p>
  
  <% if current_user.teacher? %>
    <p><strong>Classroom Code:</strong> <%= @classroom.classroom_code %></p>
  <% end %>
  
  <p><strong>Created By:</strong> <%= @classroom.teacher.name %></p>
  
  <% if current_user.student? %>
    <%= link_to "Leave this classroom", delete_classroom_enrollment_path(@classroom, @classroom.enrollments.find_by(user_id: current_user.id)) %>
  <% end %>
  
  <%= link_to 'Back to Classrooms', classrooms_path, class: 'btn btn-secondary' %>

  <% if current_user.teacher? %>
        <h2>Classroom Details</h2>
        <p>The following students are enrolled in the classroom:</p>
        
        <table>
        <th>Student Name</th>
        <th>Student Email</th>
        <th>Actions</th>
        <th>Remove Student</th>
        <% @classroom.enrollments.each do |enrollment| %>
            <tr>
            <td><%= enrollment.user.name %></td>
            <td><%= enrollment.user.email %></td>
            <td><%= link_to "View Student", user_path(enrollment.user) %></td>
            <td><%= link_to 'Remove Student', delete_classroom_enrollment_path(classroom_id: @classroom.id, id: enrollment.id) %></td>
            </tr>
        <% end %>
        </table>

        <%= form_with url: send_invitations_classroom_path(@classroom), method: :post do %>
        <label>Enter student emails (comma-separated):</label>
        <%= text_area_tag :student_emails, '', placeholder: 'student1@example.com, student2@example.com' %>
        <%= submit_tag 'Send Invitations' %>
        <% end %>

        <%= link_to 'Edit Classroom', edit_classroom_path(@classroom), class: 'btn btn-primary' %>
        <%= link_to 'Delete this classroom', delete_classroom_path(@classroom), class: 'btn btn-secondary' %>
        <%= link_to "Create a new Assignment for this Class", new_classroom_assignment_path( @classroom) %>
        
    <% end %>
    <%= link_to "Create a post in this classroom", new_classroom_post_path(@classroom)%>
    <%= link_to "See posts for this classroom", classroom_posts_path(@classroom)%>
    <%= link_to "See assignments for this classroom", classroom_assignments_path(@classroom)%>
</div>
