<%= form_with model: @classroom, local: true do |form| %>
  <% if @classroom.errors.any? %>
    <div id="error_explanation" class="alert alert-danger">
      <h2><%= pluralize(@classroom.errors.count, "error") %> prohibited this classroom from being saved:</h2>
      <ul>
        <% @classroom.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= form.label :course_code, class: "form-label" %>
    <%= form.text_area :course_code, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= form.submit "Update Classroom", class: "btn btn-primary" %>
  </div>
<% end %>
