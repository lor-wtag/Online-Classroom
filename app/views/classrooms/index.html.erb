<div class="classroom index">
    <h2>Your Classrooms</h2>
    
    <%if current_user.teacher?%>
        <%= link_to 'Create a new classroom', new_classroom_path, class: 'btn btn-success' %>
    <%end%>
    <%if @classrooms.blank?%>
        <h3>No classrooms to show</h3>
    <%else%>
        <table class="table table-bordered table-hover" summary="Classroom List">
            <thead class="table-dark">
            <tr class="header">
                <th>#</th>
                <th>Name</th>
                <th>Course Code</th>
                <% if !current_user.student?%>
                    <th>Student Count</th>
                <%end%>
                <% if current_user.admin?%>
                    <th>Created by</th>
                <%end%>
                <th>Actions</th>
            </tr>
            </thead>
            <%@classrooms.each_with_index do |classroom, index| %>
            <tr>
                <td><%= index+1%></td>
                <td><%= classroom.name%></td>
                <td><%= classroom.course_code%></td>
                <% if !current_user.student?%>
                    <td><%=classroom.users.count%></td>
                <%end%>
                <% if current_user.admin?%>
                    <td><%=classroom.teacher.name%></td>
                <%end%>
                <td class="actions">
                    <%=link_to("Show", classroom_path(classroom), class: 'btn btn-outline-primary btn-sm')%>
                    <%if !current_user.student?%>
                        <%=link_to("Edit", edit_classroom_path(classroom), class: 'btn btn-outline-secondary btn-sm')%>
                        <%=link_to("Delete",delete_classroom_path(classroom), class: 'btn btn-outline-danger btn-sm')%>
                    <%end%>

                </td>
            </tr>
            <%end%>
        </table>
    <%end%>
</div>
