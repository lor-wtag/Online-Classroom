<div class="classroom index">
    <h2>Your Classrooms</h2>
    
    <%if current_user.teacher?%>
        <%= link_to 'Create a new classroom', new_classroom_path, class: 'btn btn-secondary' %>
    <%end%>
    <%if @classrooms.blank?%>
        <h3>No classrooms to show</h3>
    <%else%>
        <table class="listing" summary="Classroom List">
            <tr class="header">
                <th>#</th>
                <th>Name</th>
                <th>Course Code</th>
                <% if !current_user.student?%>
                    <th>Student Count</th>
                <%end%>
                <th>Actions</th>
            </tr>
            <%@classrooms.each do |classroom| %>
            <tr>
                <td><%= classroom.id%></td>
                <td><%= classroom.name%></td>
                <td><%= classroom.course_code%></td>
                <% if !current_user.student?%>
                    <td><%=classroom.users.count%></td>
                <%end%>
                <td class="actions">
                    <%=link_to("Show", classroom_path(classroom),:class => "action edit")%>
                    <%if !current_user.student?%>
                        <%=link_to("Edit", edit_classroom_path(classroom),:class => "action edit")%>
                        <%=link_to("Delete",delete_classroom_path(classroom))%>
                    <%end%>

                </td>
            </tr>
            <%end%>
        </table>
    <%end%>
</div>
