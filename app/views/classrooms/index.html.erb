<div class="container mt-5">
  <h2 class="text-center mb-4">Your Classrooms</h2>
  
  <% if current_user.teacher? %>
    <div class="text-center mb-4">
      <%= link_to 'Create a new classroom', new_classroom_path, class: 'btn btn-success' %>
    </div>
  <% end %>

  <% if @classrooms.blank? %>
    <h3 class="text-center text-muted">No classrooms to show</h3>
  <% else %>
    <div class="table-responsive">
      <table class="table table-striped table-bordered table-hover">
        <thead class="table-dark">
          <tr class="header">
            <th>#</th>
            <th>Name</th>
            <th>Course Code</th>
            <% if !current_user.student? %>
              <th>Student Count</th>
            <% end %>
            <% if current_user.admin? %>
              <th>Created by</th>
            <% end %>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @classrooms.each_with_index do |classroom, index| %>
            <tr>
              <td><%= index + 1 %></td>
              <td><%= classroom.name %></td>
              <td><%= classroom.course_code %></td>
              <% if !current_user.student? %>
                <td><%= classroom.users.count %></td>
              <% end %>
              <% if current_user.admin? %>
                <td><%= classroom.teacher.name %></td>
              <% end %>
              <td class="actions">
                <%= link_to "Show", classroom_path(classroom), class: 'btn btn-outline-primary btn-sm me-2' %>
                <% if !current_user.student? %>
                  <%= link_to "Edit", edit_classroom_path(classroom), class: 'btn btn-outline-secondary btn-sm me-2' %>
                  <%= link_to "Delete", delete_classroom_path(classroom), method: :delete, data: { confirm: 'Are you sure you want to delete this classroom?' }, class: 'btn btn-outline-danger btn-sm' %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
