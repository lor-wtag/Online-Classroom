<h1 class="mb-4">Create A New Assignment</h1>
<div class="assignment-new">
  <%= form_with(model: @assignment, url: classroom_assignments_path(@classroom), method: :post) do |f| %>
    <% if @assignment.errors.any? %>
      <div class="alert alert-danger">
        <h4 class="alert-heading">There are errors:</h4>
        <ul>
          <% @assignment.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-group mb-3">
      <%= f.label :title, 'Assignment Title', class: 'form-label' %>
      <%= f.text_field :title, class: 'form-control' %>
    </div>

    <div class="form-group mb-3">
      <%= f.label :description, 'Assignment Description', class: 'form-label' %>
      <%= f.text_area :description, class: 'form-control', rows: 4 %>
    </div>

    <div class="form-group mb-3">
      <%= f.label :due_date, 'Due Date', class: 'form-label' %>
      <%= f.datetime_select :due_date, class: 'form-control' %>
    </div>

    <div class="form-group mb-3">
      <%= f.label :files, 'Upload Files (PDFs, Images, etc.)', class: 'form-label' %>
      <%= f.file_field :files, multiple: true, class: 'form-control' %>
    </div>

    <div class="form-buttons mt-3">
      <%= f.submit "Create Assignment", class: 'btn btn-primary' %>
    </div>
  <% end %>
</div>
