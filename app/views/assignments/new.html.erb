<h1>Create A New Assignment</h1>
<div class="assignment-new">
  <%= form_with(model: @assignment, url: classroom_assignments_path(@classroom), method: :post )do |f| %>
        <% if @assignment.errors.any? %>
        <div class="error-messages">
            <h2>There are errors:</h2>
            <ul>
            <% @assignment.errors.full_messages.each do |message| %>
                <li><%= message %></li>
            <% end %>
            </ul>
        </div>
        <% end %>

        <table summary="New Assignment form fields">
        <tr>
            <th>Assignment Title</th>
            <td><%= f.text_field :title %></td>
        </tr>
        <tr>
            <th>Assignment Description</th>
            <td><%= f.text_area :description %></td>
        </tr>
        <tr>
            <th>Due Date</th>
            <td>
              <%= f.date_select :due_date, start_year: Time.now.year, end_year: Time.now.year + 5, default: Time.now %>
          <%= f.time_select :due_date, default: Time.now %></td>
        </tr>
        <tr>
            <th>Upload Files (PDFs, Images, etc.)</th>
            <td><%= f.file_field :files, multiple: true %></td> 
        </tr>
        </table>

        <div class="form-buttons">
        <%= f.submit("Create Assignment") %>
        </div>
    <% end %>
</div>
