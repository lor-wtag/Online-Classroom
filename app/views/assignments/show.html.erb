<div class="show-assignment">
  <h1><%= @assignment.title %></h1>
  <p><strong>Description:</strong> <%= @assignment.description %></p>
  <p><strong>Due Date:</strong> <%= @assignment.due_date.strftime('%B %d, %Y %I:%M %p') %></p>
  
  <h2>Attached Files:</h2>
  <% if @assignment.files.attached? %>
    <ul>
      <% @assignment.files.each do |file| %>
                <div class="file-viewer">
                  <h3><%= file.filename.to_s %></h3>
                  <%= link_to 'View this file', rails_blob_path(file, disposition: 'inline'), target: '_blank', class: 'btn btn-outline-primary btn-sm' %>
                </div>
            <div class="file-download">
              <%= link_to 'Download ' + file.filename.to_s, rails_blob_path(file, disposition: 'attachment'), class: 'btn btn-outline-warning btn-sm'  %>
            </div>

        <% end %>
    </ul>
  <% else %>
    <p>No files attached.</p>
  <% end %>
  <% if !current_user.student?%>
    <%= link_to 'Edit this assignment', edit_classroom_assignment_path(@classroom, @assignment), class: 'btn btn-outline-info' %>
    <%= link_to 'Delete this assignment', delete_classroom_assignment_path(@classroom, @assignment), class: 'btn btn-outline-danger' %>
    <%= link_to "See submissions for this assignment", classroom_assignment_submissions_path(@classroom, @assignment), class: 'btn btn-primary'%>
  <%else%>
    <% if @submission%>
      <%= link_to "See submissions", classroom_assignment_submission_path(@classroom, @assignment, @submission)%>
    <%else%>
      <%= link_to "Submit your work for this assignment",new_classroom_assignment_submission_path(@classroom, @assignment) %>
    <%end%>
  <%end%>

  <h2>Comments</h2>

<%= form_with model: [@classroom, @assignment, @comment], local: true, class: 'mb-4' do |form| %>
    <div class="form-group">
      <%= form.label :content, 'Add a Comment', class: 'form-label' %>
      <%= form.text_area :content, rows: 3, class: 'form-control' %>
    </div>
    <%= form.submit 'Submit Comment', class: 'btn btn-primary' %>
  <% end %>

  <h3>All Comments:</h3>
  <% @assignment.comments.each do |comment| %>
      <div class="comment">
        <p><strong><%= comment.user.name %>:</strong> <%= comment.content %></p>
      </div>
    <% end %>

  
  <%= link_to 'Back to Assignments', classroom_assignments_path(@classroom), class: 'btn btn-warning' %>
</div>
