<h1 class="mb-4">Edit Assignment</h1>

<%= form_with model: @assignment, url: classroom_assignment_path(@classroom, @assignment), method: :patch, local: true do |f| %>
  <div class="form-group mb-3">
    <%= f.label :title, 'Assignment Title', class: 'form-label' %>
    <%= f.text_field :title, class: 'form-control', required: true, placeholder: 'Enter assignment title' %>
  </div>

  <div class="form-group mb-3">
    <%= f.label :description, 'Description', class: 'form-label' %>
    <%= f.text_area :description, class: 'form-control', rows: 4, placeholder: 'Provide a detailed description of the assignment' %>
  </div>

  <div class="form-group mb-3">
    <%= f.label :due_date, 'Due Date', class: 'form-label' %>
    <%= f.datetime_select :due_date, class: 'form-control' %>
  </div>

  <div class="form-group mb-3">
    <%= f.label :files, 'Attach File(s)', class: 'form-label' %>
    <%= f.file_field :files, multiple: true, class: 'form-control' %>
  </div>
    <% if @assignment.files.attached? %>
        <h3>Current Files</h3>
        <% @assignment.files.each_with_index do |file, index| %>
            <div class="file">
            <%= link_to file.filename.to_s, rails_blob_path(file, disposition: 'inline'), target: '_blank' %>
            <%= check_box_tag "assignment[remove_files][]", file.id %> Remove
            </div>
        <% end %>
    <%end%>

  <div class="form-group text-center mt-4">
    <%= f.submit 'Update Assignment', class: 'btn btn-success btn-lg' %>
  </div>
<% end %>

<div class="back-link text-center mt-3">
  <%= link_to 'Back to Assignment', classroom_assignment_path(@classroom, @assignment), class: 'btn btn-secondary' %>
</div>
