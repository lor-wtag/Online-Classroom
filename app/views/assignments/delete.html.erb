<%= link_to "Go Back", classroom_assignments_path, class: "btn btn-outline-secondary mb-4" %>

<div class="delete-classroom">
  <h1 class="mb-4 text-danger">Delete Assignment</h1>

  <%= form_with model: @assignment, url: classroom_assignment_path(@classroom, @assignment), method: :delete, local: true do |f| %>
    
    <div class="alert alert-warning mb-4" role="alert">
      <strong>Warning:</strong> Deleting an assignment is permanent and cannot be undone.
    </div>

    <p>Are you sure you want to delete the assignment with the following details?</p>

    <table class="table table-bordered mb-4">
      <tr>
        <th>Name</th>
        <td><%= f.object.title %></td>
      </tr>
      <tr>
        <th>Description</th>
        <td><%= f.object.description %></td>
      </tr>
    </table>

    <div class="form-buttons text-center">
      <%= f.submit "Delete Assignment", class: "btn btn-danger btn-lg" %>
    </div>
  <% end %>
</div>
