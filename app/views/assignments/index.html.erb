   <%= link_to 'Back to classroom', classroom_path(@classroom), class: 'btn btn-secondary' %>
   <h3>Assignments for this Classroom:</h3>
    <% if @classroom.assignments.any? %>
      <table class="table table-hover">
        <thead class="table-dark">
          <tr>
            <th>Assignment Title</th>
            <th>Description</th>
            <th>Due Date</th>

                <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @classroom.assignments.each do |assignment| %>
            <tr>
              <td><%= assignment.title %></td>
              <td><%= assignment.description %></td>
              <td><%= assignment.due_date.strftime('%B %d, %Y %I:%M %p') %></td>
              <td><%= link_to "View Assignment", classroom_assignment_path(@classroom, assignment), class:'btn btn-outline-primary btn-sm' %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p>No assignments yet.</p>
    <% end %>