<div class="container mt-5">
  <h1 class="text-center mb-4">Reset Your Password</h1>

  <div class="card shadow-sm p-4">
    <%= form_with(model: @user, url: password_reset_path(token: params[:token]), local: true) do |f| %>

      <% if @user.errors.any? %>
        <div class="alert alert-danger">
          <h4 class="alert-heading">There are errors:</h4>
          <ul>
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-3">
        <%= f.label :password, "New Password", class: 'form-label' %>
        <%= f.password_field :password, class: 'form-control', placeholder: 'Enter new password' %>
      </div>

      <div class="mb-3">
        <%= f.label :password_confirmation, "Confirm New Password", class: 'form-label' %>
        <%= f.password_field :password_confirmation, class: 'form-control', placeholder: 'Confirm your new password' %>
      </div>

      <div class="form-buttons text-center">
        <%= f.submit "Reset Password", class: 'btn btn-primary w-100' %>
      </div>
    <% end %>
  </div>
</div>
