<h3>Provide your Email</h3>
<div class="password-reset">
    <%= form_with model: @user, url: password_reset_path do |f| %>

        <table summary="User form field">
        <tr>
            <th>Email</th>
            <td><%= f.text_field :email %></td>
        </tr>
        </table>
        <div class="form buttons">
        <%= f.submit "Send Email for Resetting Password?" %>
        </div>
    <% end %>
</div>
