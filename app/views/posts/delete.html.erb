<h1>Are you sure you want to delete this post?</h1>

<div class="post-details">
  <h2><%= @post.title %></h2>
  <p><%= @post.content %></p>
</div>

<%= form_with url: classroom_post_path(@classroom, @post), method: :delete do |f| %>
  <%= f.submit 'Yes, delete this post', class: 'btn btn-danger' %>
  <%= link_to 'No, go back', classroom_post_path(@classroom, @post), class: 'btn btn-secondary' %>
<% end %>