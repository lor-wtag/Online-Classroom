<div class="container mt-5">
  <h1 class="text-danger mb-4">Are you sure you want to delete this post?</h1>

  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <h2 class="card-title"><%= @post.title %></h2>
      <p class="card-text"><%= @post.content %></p>
    </div>
  </div>

  <div class="d-flex justify-content-between">
    <%= form_with url: classroom_post_path(@classroom, @post), method: :delete, local: true do |f| %>
      <%= f.submit 'Yes, delete this post', class: 'btn btn-danger' %>
    <% end %>

    <%= link_to 'No, go back', classroom_post_path(@classroom, @post), class: 'btn btn-secondary' %>
  </div>
</div>
