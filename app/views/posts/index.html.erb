<h1>Posts in <%= @classroom.name %></h1>

<%= link_to 'Create a New Post', new_classroom_post_path(@classroom), class: 'btn btn-primary' %>

<% if @posts.any? %>
  <div class="posts-list">
    <% @posts.each do |post| %>
      <div class="post-item">
        <h3><%= post.title %></h3>
        <p><%= post.content %></p>
        
        <div class="post-actions">
          <%= link_to 'View', classroom_post_path(@classroom, post), class: 'btn btn-info' %>
          <% if current_user == post.user || current_user.admin? %>
            <%= link_to 'Edit', edit_classroom_post_path(@classroom, post), class: 'btn btn-warning' %> |
            <%= link_to 'Delete', classroom_post_path(@classroom, post), method: :delete, data: { confirm: 'Are you sure you want to delete this post?' }, class: 'btn btn-danger' %>
          <% end %>
        </div>
      </div>
      <hr>
    <% end %>
  </div>
<% else %>
  <p>No posts available in this classroom.</p>
<% end %>
