<h1><%= @post.title %></h1>
<p><%= @post.content %></p>

<div class="post-comments">
  <h3>Comments:</h3>

  <%= form_with(model: [@classroom, @post, @post.comments.build], local: true) do |f| %>
    <div class="form-group">
      <%= f.label :content, 'Your Comment' %>
      <%= f.text_area :content, class: 'form-control' %>
    </div>
    <%= f.submit 'Post Comment', class: 'btn btn-primary' %>
  <% end %>
</div>

<h3>All Comments:</h3>
<% @post.comments.each do |comment| %>
  <div class="comment">
    <% if comment.user.present? %>
      <p><strong><%= comment.user.name %>:</strong> <%= comment.content %></p>
    <% else %>
      <p><strong>Unknown User:</strong> <%= comment.content %></p>
    <% end %>
  </div>
<% end %>

<%= link_to 'Back to Posts', classroom_posts_path(@classroom), class: 'btn btn-secondary' %>
