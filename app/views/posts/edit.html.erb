<h1>Edit Post</h1>

<%= form_with(model: @post, url: classroom_post_path(@classroom, @post), method: :patch) do |f| %>
  <% if @post.errors.any? %>
    <div class="error-messages">
      <h2>There are errors:</h2>
      <ul>
        <% @post.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :title %>
    <%= f.text_field :title, class: 'form-control' %>
  </div>

  <div class="form-group">
    <%= f.label :content %>
    <%= f.text_area :content, class: 'form-control' %>
  </div>

  <%= f.submit 'Update Post', class: 'btn btn-primary' %>
<% end %>

<%= link_to 'Back to Post', classroom_post_path(@classroom, @post), class: 'btn btn-secondary' %>
