<div class="container mt-5">
  <h1 class="text-primary mb-4">Edit Post</h1>

  <% if @post.errors.any? %>
    <div class="alert alert-danger">
      <h4 class="alert-heading">There are errors:</h4>
      <ul>
        <% @post.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="card shadow-sm">
    <div class="card-body">
      <%= form_with(model: @post, url: classroom_post_path(@classroom, @post), method: :patch, local: true) do |f| %>
        <div class="mb-3">
          <%= f.label :title, "Post Title", class: "form-label" %>
          <%= f.text_field :title, class: "form-control", placeholder: "Enter the post title" %>
        </div>

        <div class="mb-3">
          <%= f.label :content, "Post Content", class: "form-label" %>
          <%= f.text_area :content, class: "form-control", rows: 5, placeholder: "Update your post content here..." %>
        </div>

        <div class="d-flex justify-content-between mt-4">
          <%= f.submit 'Update Post', class: 'btn btn-primary' %>
          <%= link_to 'Back to Post', classroom_post_path(@classroom, @post), class: 'btn btn-secondary' %>
        </div>
      <% end %>
    </div>
  </div>
</div>
