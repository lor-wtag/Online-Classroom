<div class="container mt-5">
  <h1 class="text-center mb-4">Update Your Password</h1>

  <div class="card shadow-sm p-4">
    <%= form_with(model: current_user, url: password_path, local: true) do |f| %>
      <% if f.object.errors.any? %>
        <div class="alert alert-danger">
          <h4 class="alert-heading">There are errors:</h4>
          <ul>
            <% f.object.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <div class="mb-3">
        <%= f.label :password_challenge, "Current Password", class: 'form-label' %>
        <%= f.password_field :password_challenge, class: 'form-control', placeholder: 'Enter current password' %>
      </div>
      
      <div class="mb-3">
        <%= f.label :password, "New Password", class: 'form-label' %>
        <%= f.password_field :password, class: 'form-control', placeholder: 'Enter new password' %>
      </div>
      
      <div class="mb-3">
        <%= f.label :password_confirmation, "Confirm New Password", class: 'form-label' %>
        <%= f.password_field :password_confirmation, class: 'form-control', placeholder: 'Confirm new password' %>
      </div>

      <div class="form-buttons text-center">
        <%= f.submit "Update Password", class: 'btn btn-primary w-100' %>
      </div>
    <% end %>
  </div>
</div>
