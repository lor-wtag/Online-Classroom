<%= link_to("Go Back", classrooms_path, class: "back-link") %>
<div class="remove student">
    <h1>Remove Student from <%=@classroom.name%></h1>
    <%= form_with url: classroom_enrollment_path(classroom_id: @classroom.id, id: @enrollment.id), method: :delete do |f| %>
        <p>Are you sure you want to remove the student with the following details?</p>
        <p><strong>Name:</strong> <%= @enrollment.user.name %></p>
        <p><strong>Email:</strong> <%= @enrollment.user.email %></p>
        <div class="form buttons">
            <%= f.submit("Remove Student from this classroom") %>
        </div>
    <% end %>
</div>
