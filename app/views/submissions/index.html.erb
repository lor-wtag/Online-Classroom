  <%= link_to 'Back to Assignment', classroom_assignment_path(@classroom, @assignment), class: 'btn btn-secondary' %>

<h3>Submissions for <%= @assignment.title %>:</h3>

<% if @assignment.submissions.any? %>
  <table class="table table-bordered table-hover">
    <thead class="table-dark">
      <tr>
        <th>Student</th>
        <th>Submission Files</th>
        <th><%= sort_link(@q, :grade, "Grade") %></th>
        <th>Feedback</th>
        <th><%= sort_link(@q, :created_at, "Submitted At") %></th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @submissions.each do |submission| %>
        <tr>
          <td><%= submission.user.name %></td>
          <td>
            <% if submission.files.attached? %>
              <% submission.files.each do |file| %>
                <%= link_to file.filename.to_s, rails_blob_path(file, disposition: "inline") %><br>
              <% end %>
            <% else %>
              No files uploaded
            <% end %>
          </td>
          <td><%= submission.grade || "Not graded" %></td>
          <td><%= submission.feedback || "No feedback" %></td>
          <td><%= submission.created_at.strftime('%B %d, %Y %I:%M %p') %></td>
          <td>
            <%= link_to "View", classroom_assignment_submission_path(@classroom, @assignment, submission), class:'btn btn-outline-primary' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No submissions yet.</p>
<% end %>
