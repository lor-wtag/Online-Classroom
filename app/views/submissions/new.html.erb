<h1 class="mb-4">Submit your work here</h1>
<div class="submission-new">
  <%= form_with(model: @submission, url: classroom_assignment_submissions_path(@classroom, @assignment), method: :post) do |f| %>
    
    <% if @submission.errors.any? %>
      <div class="alert alert-danger">
        <h4 class="alert-heading">There are errors:</h4>
        <ul>
          <% @submission.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-group mb-3">
      <%= f.label :assignment_title, 'Assignment Title', class: 'form-label' %>
      <p><%= @assignment.title %></p>
    </div>

    <div class="form-group mb-3">
      <%= f.label :due_date, 'Due Date', class: 'form-label' %>
      <p><%= @assignment.due_date.strftime('%B %d, %Y %I:%M %p') %></p>
    </div>

    <div class="form-group mb-3">
      <%= f.label :files, 'Upload Your Files', class: 'form-label' %>
      <%= f.file_field :files, required: true, class: 'form-control' %>
    </div>

    <div class="form-buttons mt-3">
      <%= f.submit "Submit your work", class: 'btn btn-primary' %>
    </div>
  <% end %>
</div>
