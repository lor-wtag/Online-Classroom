<div class="show-submission">
    <h1><%= @assignment.title %></h1>
    <p><strong>Description:</strong> <%= @assignment.description %></p>
    <p><strong>Due Date:</strong> <%= @assignment.due_date.strftime('%B %d, %Y %I:%M %p') %></p>
    <% if @submission.grade.present? %>
        <p><strong>Grade:</strong> <%= @submission.grade %></p>
    <% else %>
        <p>No grade assigned yet.</p>
    <% end %>

    <% if @submission.feedback.present? %>
        <p><strong>Feedback:</strong> <%= @submission.feedback %></p>
    <% else %>
        <p>No feedback provided.</p>
<% end %>
  
    <h2>Attached Files:</h2>
    <% if @submission.files.attached? %>
        <ul>
        <% @submission.files.each do |file| %>
                <div class="file-viewer">
                    <h3><%= file.filename.to_s %></h3>
                    <%= link_to 'View this file', rails_blob_path(file, disposition: 'inline'), target: '_blank', class: 'btn btn-primary' %>
                </div>
                <div class="file-download">
                <%= link_to 'Download ' + file.filename.to_s, rails_blob_path(file, disposition: 'attachment') %>
                </div>

            <% end %>
        </ul>
        <%=link_to "Edit this submission", edit_classroom_assignment_submission_path(@classroom, @assignment, @submission)%>
    <% else %>
        <p>No files attached.</p>
        <%= link_to "Submit your work for this assignment",new_classroom_assignment_submission_path(@classroom, @assignment) %>
    <% end %>  
    <% if can? :grade, @submission %>
        <%= form_with model: @submission, url: grade_classroom_assignment_submission_path(@classroom, @assignment, @submission), method: :patch do |f| %>
            <div class="form-group">
            <%= f.label :grade %>
            <%= f.number_field :grade, step: 0.1, class: 'form-control' %>
            </div>

            <div class="form-group">
            <%= f.label :feedback %>
            <%= f.text_area :feedback, class: 'form-control' %>
            </div>

            <%= f.hidden_field :graded_at, value: Time.current %>

            <%= f.submit 'Submit Grade', class: 'btn btn-primary' %>
        <% end %>
    <% end %>
    <h2>Comments</h2>

    <%= form_with model: [ @classroom, @assignment, @submission, @comment ], local: true do |form| %>
        <div class="field">
            <%= form.label :content, 'Add a Comment' %>
            <%= form.text_area :content, rows: 3 %>
        </div>

        <%= form.submit 'Submit Comment' %>
    <% end %>

    <h3>All Comments:</h3>
    <% @submission.comments.each do |comment| %>
        <div class="comment">
        <p><strong><%= comment.user.name %>:</strong> <%= comment.content %></p>
        </div>
    <% end %>

    
    <%= link_to 'Back to Assignments', classroom_assignment_path(@classroom,@assignment), class: 'btn btn-secondary' %>
</div>
