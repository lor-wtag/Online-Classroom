<div class="container mt-5">
  <% if user_not_logged_in? %>
    <div class="text-center">
      <h2 class="text-primary"><%= t("welcome") %></h2>
      <p class="lead"><%= t("login_or_signup_message")%></p>
    </div>
  <% else %>
    <div class="text-center">
      <h2 class="text-success">Welcome, <%= current_user.name %>!</h2>
      <h4 class="text-muted text-capitalize"><%= current_user.role %></h4>
    </div>
    <div class="mt-4 text-center">
      <% if current_user.teacher? %>
        <%= link_to "Create a New Classroom", new_classroom_path, class: "btn btn-outline-primary me-2" %>
        <%= link_to "See Your Classrooms", classrooms_path, class: "btn btn-outline-success" %>
      <% elsif current_user.student? %>
        <%= link_to "Enroll in a Classroom", enroll_classrooms_path, class: "btn btn-outline-primary me-2" %>
        <%= link_to "See Your Classrooms", classrooms_path, class: "btn btn-outline-success" %>
      <% elsif current_user.admin? %>
        <%= link_to "Create a New User", new_user_path, class: "btn btn-outline-warning me-2" %>
        <%= link_to "See All Users", users_path, class: "btn btn-outline-info me-2" %>
        <%= link_to "See All Classrooms", classrooms_path, class: "btn btn-outline-dark" %>
      <% end %>
    </div>
  <% end %>
</div>
